{
  "manifest_version": 3,
  "name": "SalesQL → AIESEC Marcall Tracker",
  "version": "1.0",
  "description": "Auto-insert SalesQL revealed contacts into AIESEC Marcall Tracker Google Sheet",

  "permissions": [
    "identity",
    "storage"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
  {
    "matches": ["https://www.linkedin.com/*"],
    "js": [
      "modules/scraper.js",
      "modules/banner.js",
      "modules/scanner.js",
      "modules/observer.js",
      "content.js"
    ],
    "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {}
  },

  "oauth2": {
    "client_id": "",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },

  "icons": {}
}